From 440d7f8bcf32f1f89e5ccfbbb82e6d00c39522e0 Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Thu, 7 Nov 2024 16:25:14 -0600
Subject: [PATCH] 312 SC598 Disable Sport DMA

---
 arch/arm64/boot/dts/adi/sc59x-64.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/adi/sc59x-64.dtsi b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
index 40e9071240b3..b0ba820bcfc7 100644
--- a/arch/arm64/boot/dts/adi/sc59x-64.dtsi
+++ b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
@@ -1065,7 +1065,7 @@ pkte1: pkte@310CD000 {
 		sport0_dma_cluster: dma@0x31022000 {
 			compatible = "adi,dma-controller";
 			reg = <0x31022000 0x1000>;
-			status = "okay";
+			status = "disabled";
 			#dma-cells = <1>;
 
 			sport0a: channel@0 {
@@ -1091,7 +1091,7 @@ sport0b: channel@1 {
 		sport4_dma_cluster: dma@0x31023000 {
 			compatible = "adi,dma-controller";
 			reg = <0x31023000 0x1000>;
-			status = "okay";
+			status = "disabled";
 			#dma-cells = <1>;
 
 			sport4a: channel@10 {
-- 
2.25.1

