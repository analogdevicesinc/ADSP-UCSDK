From 0e49309c40f9a665561bc4938744c7644acedabd Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Thu, 25 Apr 2024 12:45:18 -0500
Subject: [PATCH] SC57x enable gpt_ctr and assign TMR5 to PC15

---
 arch/arm/boot/dts/sc573-ezkit.dts | 12 ++++++++++++
 arch/arm/boot/dts/sc57x.dtsi      |  5 +++++
 2 files changed, 17 insertions(+)

diff --git a/arch/arm/boot/dts/sc573-ezkit.dts b/arch/arm/boot/dts/sc573-ezkit.dts
index d15d9a5ca2f8..959c81e70d3b 100644
--- a/arch/arm/boot/dts/sc573-ezkit.dts
+++ b/arch/arm/boot/dts/sc573-ezkit.dts
@@ -494,7 +494,19 @@
 	status = "okay";
 };
 
+&gptimer_counter {
+	/* enable PC_15 to work as TIMER0_TMR5 */
+	pinctrl-names = "default";
+	pinctrl-0 = <&extclkin_default>;
+	status = "okay";
+};
+
 &pinctrl0 {
+	extclkin_default: extclkin_default_pins {
+		pins {
+			pinmux = <ADI_ADSP_PINMUX('C', 15, ADI_ADSP_PINFUNC_ALT3)>;
+		};
+	};
 	uart0_default: uart0_default_pins {
 		pins {
 			pinmux = <ADI_ADSP_PINMUX('F', 8, ADI_ADSP_PINFUNC_ALT0)>,
diff --git a/arch/arm/boot/dts/sc57x.dtsi b/arch/arm/boot/dts/sc57x.dtsi
index 2de66f5e4a7f..dc4f5ec5b817 100644
--- a/arch/arm/boot/dts/sc57x.dtsi
+++ b/arch/arm/boot/dts/sc57x.dtsi
@@ -220,6 +220,11 @@
 			status = "disabled";
 		};
 
+		gptimer_counter: gptimer-counters@0 {
+			compatible = "adi,gptimer-counter";
+			status = "okay";
+		};
+
 		rcu: rcu@0x3108B000 {
 			compatible = "adi,reset-controller";
 			reg = <0x3108C000 0x1000>;
-- 
2.25.1

