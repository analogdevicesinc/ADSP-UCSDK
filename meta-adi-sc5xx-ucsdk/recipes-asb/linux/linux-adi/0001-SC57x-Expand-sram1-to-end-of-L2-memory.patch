From af8ef3a249d349aee35747985809b5bd9f01c047 Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Wed, 24 Apr 2024 10:52:26 -0500
Subject: [PATCH] SC57x Expand sram1 to end of L2 memory

---
 arch/arm/boot/dts/sc57x.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/sc57x.dtsi b/arch/arm/boot/dts/sc57x.dtsi
index 03a9fee50b22..2de66f5e4a7f 100644
--- a/arch/arm/boot/dts/sc57x.dtsi
+++ b/arch/arm/boot/dts/sc57x.dtsi
@@ -90,8 +90,8 @@
 		compatible = "mmio-sram";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		reg = <0x20004000 0x3B000>;
-		ranges = <0 0x20004000 0x3B000>;
+		reg = <0x20004000 0xFC000>;
+		ranges = <0 0x20004000 0xFC000>;
 	};
 
 	sys_clkin0: sys-clkin0@1 {
-- 
2.25.1

