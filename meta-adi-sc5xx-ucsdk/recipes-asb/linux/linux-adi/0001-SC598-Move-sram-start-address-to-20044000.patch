From 9cfaaec0c7f0334b28cf108bdc1e82bffa632ef6 Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Wed, 10 Apr 2024 13:10:40 -0500
Subject: [PATCH] SC598 Move sram start address to 20044000

---
 arch/arm64/boot/dts/adi/sc59x-64.dtsi | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/adi/sc59x-64.dtsi b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
index ccfc4e1b8e18..af394d8a03b8 100644
--- a/arch/arm64/boot/dts/adi/sc59x-64.dtsi
+++ b/arch/arm64/boot/dts/adi/sc59x-64.dtsi
@@ -89,8 +89,8 @@ sram1: sram-reserved@20040000 {
 		compatible = "mmio-sram";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		reg = <0x20040000 0x40000>;
-		ranges = <0 0x20040000 0x40000>; /*256KiB*/
+		reg = <0x20044000 0x3C000>;
+		ranges = <0 0x20044000 0x3C000>; /*240KiB*/
 	};
 
 	timer {
-- 
2.25.1

