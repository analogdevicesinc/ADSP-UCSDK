From dfb44c317dc7023b71208b920310dd86dd69e876 Mon Sep 17 00:00:00 2001
From: Harvin Bryce D'Almeida <harvin.almeida@analog.com>
Date: Thu, 27 Feb 2025 18:35:33 +0000
Subject: [PATCH] 312 SC594 L2 sram start at 0x20044000

Signed-off-by: Harvin Bryce D'Almeida <harvin.almeida@analog.com>
---
 arch/arm/boot/dts/sc59x.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/sc59x.dtsi b/arch/arm/boot/dts/sc59x.dtsi
index bc1f788a66f8..ae3b06b5bd1e 100644
--- a/arch/arm/boot/dts/sc59x.dtsi
+++ b/arch/arm/boot/dts/sc59x.dtsi
@@ -88,12 +88,12 @@ sram0: sram-icc@20000000 {
 		ranges = <0 0x20025000 0x1B000>; /*108KiB*/
 	};
 
-	sram1: sram-reserved@20040000 {
+	sram1: sram-reserved@20044000 {
 		compatible = "mmio-sram";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		reg = <0x20040000 0x40000>;
-		ranges = <0 0x20040000 0x40000>; /*256KiB*/
+		reg = <0x20044000 0x3C000>;
+		ranges = <0 0x20044000 0x3C000>; /*240KiB*/
 	};
 
 	sys_clkin0: sys-clkin0@1 {
-- 
2.25.1

