From 262380d3ff7fae5621d68936761399d808ef8f07 Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Tue, 6 May 2025 14:04:53 -0500
Subject: [PATCH] SC573 L2 sram start at 0x20044000

---
 arch/arm/boot/dts/sc57x.dtsi | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/boot/dts/sc57x.dtsi b/arch/arm/boot/dts/sc57x.dtsi
index c109ce03a9c5..9bc8c7a5150c 100644
--- a/arch/arm/boot/dts/sc57x.dtsi
+++ b/arch/arm/boot/dts/sc57x.dtsi
@@ -85,12 +85,12 @@ sram0: sram-icc@20000000 {
 		ranges = <0 0x20010000 0x1000>; /* 64 KiB */
 	};
 
-	sram1: sram-reserved@20004000 {
+	sram1: sram-reserved@20044000 {
 		compatible = "mmio-sram";
 		#address-cells = <1>;
 		#size-cells = <1>;
-		reg = <0x20040000 0x40000>;
-		ranges = <0 0x20040000 0x40000>; /* 256 KiB */
+		reg = <0x20044000 0x3C000>;
+		ranges = <0 0x20044000 0x3C000>; /* 256 KiB */
 	};
 
 	sys_clkin0: sys-clkin0@1 {
-- 
2.49.0

