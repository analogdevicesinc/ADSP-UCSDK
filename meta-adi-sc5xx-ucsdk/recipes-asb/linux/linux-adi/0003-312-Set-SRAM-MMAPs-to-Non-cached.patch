From 89523701fda600f539ba2d6b023a22c62d792720 Mon Sep 17 00:00:00 2001
From: Harvin Almeida <harvin.almeida@analog.com>
Date: Mon, 11 Nov 2024 13:19:05 -0600
Subject: [PATCH] 312 Set SRAM MMAPs to Non cached

---
 drivers/misc/adi/sram_mmap.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/misc/adi/sram_mmap.c b/drivers/misc/adi/sram_mmap.c
index c50f92824318..0dedca9bdbe5 100644
--- a/drivers/misc/adi/sram_mmap.c
+++ b/drivers/misc/adi/sram_mmap.c
@@ -100,7 +100,7 @@ static int sram_mmap(struct file *fp, struct vm_area_struct *vma)
 
 	fp->f_mapping->a_ops = &sram_aops;
 	vma->vm_page_prot = __pgprot_modify(vma->vm_page_prot, PTE_ATTRINDX_MASK,
-		PTE_ATTRINDX(MT_NORMAL) | PTE_PXN | PTE_UXN);
+		PTE_ATTRINDX(MT_NORMAL_NC) | PTE_PXN | PTE_UXN);
 	vma->vm_private_data = sram;
 	vma->vm_ops = NULL;
 
